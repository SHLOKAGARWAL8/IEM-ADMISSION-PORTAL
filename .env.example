PORT=4000
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
DATABASE_PATH=./data/iem.sqlite
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# Required for real email verification. Use a Gmail App Password, not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
