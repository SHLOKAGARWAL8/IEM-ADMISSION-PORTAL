PORT=4000
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
DATA_DIR=./data
DATABASE_PATH=./data/iem.sqlite
ACCOUNT_CSV_PATH=./data/accounts.csv
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# Password recovery email (Resend). Use a verified sender/domain.
RESEND_API_KEY=
PASSWORD_RESET_FROM=IEM Admissions <no-reply@your-verified-domain.example>
APP_BASE_URL=https://iem-admission-portal-1.onrender.com

# CSV snapshots for accounts, applications, documents, statuses, notifications, etc.
# In production, set DATA_DIR and DATABASE_PATH to the Render persistent disk.
